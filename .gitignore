# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Real examiner credentials (SNAGR_AUTH_USER/PASS) — see engine/.env.example.
# Never commit the real file, only the template.
engine/.env

# Node / Electron
node_modules/
dist/
dist-electron/
*.log
*.tsbuildinfo

# Tool output
cases/
_corpus/
*.local

# OS
.DS_Store

# Bundled binaries (large; fetched at package time)
engine/vendor/platform-tools/

# Android build output
apk/.gradle/
apk/app/build/
apk/.idea/
.idea/
local.properties

# Loose pulled device data (sensitive — never commit real evidence)
engine/contacts.json
engine/calllog.json
engine/sms.json
engine/contacts_pulled.json
engine/*.error.json

# Test / benchmark output. `engine/_test_output/` was previously committed — 58 files of a
# generated case folder, including artifacts and hashes from a synthetic run. Committed
# case output is confusing at best (it looks like real evidence in the tree) and it churns
# on every benchmark run.
engine/_test_output/
.coverage
.coverage.*
htmlcov/

# Root-level pulled device evidence files
/calllog.json
/contacts.json
/sms.json
# Ad-hoc dumpsys captures taken while testing against a real handset. Same hazard as the
# JSON above: they are real device data that lands in the repo root during a session.
/bt_dump.txt
/*_dump.txt
/dumpsys_*.txt
