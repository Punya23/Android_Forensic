# Copy this file to .env (same directory) and fill in real values.
# `cp .env.example .env`
#
# .env is gitignored — real credentials never get committed, only this template.
# Loaded automatically by triage/server.py on startup (engine/.env, regardless of
# which directory the server was launched from).
#
# If .env is missing or ERAKSHAK_AUTH_PASS is unset, the server falls back to
# examiner/erakshak and prints a warning at startup. Fine for local dev against
# synthetic corpora — replace before this handles real evidence.

ERAKSHAK_AUTH_USER=your-name
ERAKSHAK_AUTH_PASS=change-me-to-something-real
