# Release signing key for the SNAGR Collector APK.
#
# Copy this file to `apk/keystore.properties` (git-ignored, never commit the real one)
# and point it at a real keystore, e.g.:
#
#   keytool -genkeypair -v -keystore snagr-release.jks -alias snagr \
#       -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file, `./gradlew :app:assembleRelease` still builds — it falls back to
# the debug key (see apk/app/build.gradle) rather than producing an unsigned APK.

storeFile=snagr-release.jks
storePassword=CHANGE_ME
keyAlias=snagr
keyPassword=CHANGE_ME
